# All settings are optional. Only public market-data endpoints are used,
# so no API key or secret is needed (or read).

# REST base URL. Alternatives: https://data-api.binance.vision (market data only)
BINANCE_REST_URL=https://api.binance.com

# Websocket base URL. Alternative: wss://data-stream.binance.vision (market data only)
BINANCE_WS_URL=wss://stream.binance.com:9443

LOG_LEVEL=INFO
